
---
import BaseLayout from '@/layouts/BaseLayout.astro'
import CommonHeader from '@/components/common/CommonHeader.vue'
import PageHeader from '@/components/common/PageHeader.vue'
import ReminderSettingsContent from '@/components/case-detail-view-reminder-settings/ReminderSettingsContent.vue'

const breadcrumbs = [
  { label: '案件管理', href: './case-list-view.html' },
  { label: '案件详情', href: './case-detail-view.html' },
  { label: '提醒设置' },
]
---

<BaseLayout title="案件提醒设置 - 诉讼案件管理系统">
  <CommonHeader client:load />
  <div class="flex flex-col min-h-[calc(100vh-64px)]">
    <PageHeader 
      title="案件提醒设置"
      description="为案件设置或修改自动生成和自定义的提醒事项"
      :breadcrumbs={breadcrumbs}
    />
    <main class="flex-1 overflow-auto">
      <ReminderSettingsContent client:load />
    </main>
  </div>
</BaseLayout>
