
---
import BaseLayout from '@/layouts/BaseLayout.astro'
import CommonHeader from '@/components/common/CommonHeader.vue'
import AppSidebarLayout from '@/components/common/AppSidebarLayout.vue'
import PageHeader from '@/components/common/PageHeader.vue'
import UserCreateEditForm from '@/components/user-create-edit/UserCreateEditForm.vue'
---

<BaseLayout title="创建/编辑用户 - 诉讼案件管理系统">
  <CommonHeader client:load />
  <AppSidebarLayout client:load headerHeight="64px">
    <main class="flex-1 flex flex-col">
<PageHeader 
        title="用户管理"
        description="创建新用户或编辑现有用户信息"
        breadcrumbs={[
          { label: '用户管理中心', href: './user-management-dashboard.html' },
          { label: '用户列表', href: './user-list.html' },
          { label: '创建/编辑用户' }
        ]}
        client:load
      />
      
      <div class="flex-1 overflow-auto">
        <div class="container mx-auto px-4 py-6">
          <UserCreateEditForm client:load />
        </div>
      </div>
    </main>
  </AppSidebarLayout>
</BaseLayout>
