
---
import BaseLayout from '@/layouts/BaseLayout.astro'
import CommonHeader from '@/components/common/CommonHeader.vue'
import AppSidebarLayout from '@/components/common/AppSidebarLayout.vue'
import PageHeader from '@/components/common/PageHeader.vue'
import PresetTemplateList from '@/components/document-template-preset-list/PresetTemplateList.vue'
---

<BaseLayout title="系统预设模板列表 - 诉讼案件管理系统">
  <CommonHeader client:load />
  <AppSidebarLayout client:load headerHeight="64px">
    <main class="flex-1 flex flex-col">
      <PageHeader 
        title="系统预设模板列表"
        description="浏览系统提供的所有标准文书模板，了解各模板的用途和内容"
        :breadcrumbs={[
          { label: '文书管理', href: './document-generation-entry.html' },
          { label: '模板管理', href: './document-template-management.html' },
          { label: '预设模板' }
        ]}
      />
      <PresetTemplateList client:idle />
    </main>
  </AppSidebarLayout>
</BaseLayout>
