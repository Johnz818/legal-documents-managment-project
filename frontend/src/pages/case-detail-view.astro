
---
import BaseLayout from '@/layouts/BaseLayout.astro'
import CommonHeader from '@/components/common/CommonHeader.vue'
import AppSidebarLayout from '@/components/common/AppSidebarLayout.vue'
import CaseDetailContent from '@/components/case-detail-view/CaseDetailContent.vue'

// Static output cannot read the browser query string; the client resolves the ID after hydration.
const defaultCaseId = ''
---

<BaseLayout title="案件详情 - 诉讼案件管理系统">
  <CommonHeader client:load />
  <AppSidebarLayout client:load headerHeight="64px">
    <main class="flex-1 flex flex-col">
      <CaseDetailContent client:load caseId={defaultCaseId} />
    </main>
  </AppSidebarLayout>
</BaseLayout>
