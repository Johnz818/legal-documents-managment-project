
---
import BaseLayout from '@/layouts/BaseLayout.astro'
import CommonHeader from '@/components/common/CommonHeader.vue'
import AppSidebarLayout from '@/components/common/AppSidebarLayout.vue'
import PageHeader from '@/components/common/PageHeader.vue'
import DocumentGenerateSelectionView from '@/components/document-generate-selection/DocumentGenerateSelection.vue'
---

<BaseLayout title="选择文书生成 - 诉讼案件管理系统">
  <CommonHeader client:load />
  <AppSidebarLayout client:load headerHeight="64px">
    <main class="flex-1 flex flex-col">
      <PageHeader 
        title="选择文书生成"
        description="选择需要生成文书的案件和使用的模板，系统将自动填充并生成文书初稿"
        breadcrumbs={[
          { label: '文书管理', href: './document-generation-entry.html' },
          { label: '选择文书生成' }
        ]}
      />
      <DocumentGenerateSelectionView client:load />
    </main>
  </AppSidebarLayout>
</BaseLayout>
