
---
import BaseLayout from '@/layouts/BaseLayout.astro'
import AppHeader from '@/components/common/AppHeader.vue'
import AppSidebarLayout from '@/components/common/AppSidebarLayout.vue'
import PageHeader from '@/components/common/PageHeader.vue'
import CaseListHeader from '@/components/case-list-view/CaseListHeader.vue'
import CaseListFilters from '@/components/case-list-view/CaseListFilters.vue'
import CaseListTable from '@/components/case-list-view/CaseListTable.vue'
import CaseListActions from '@/components/case-list-view/CaseListActions.vue'
---

<BaseLayout title="案件列表 - 诉讼案件管理系统">
  <AppHeader client:load />
  <AppSidebarLayout client:only="vue" headerHeight="64px">
    <main class="flex-1 flex flex-col">
      <PageHeader 
        title="案件列表"
        description="集中管理所有诉讼案件，支持筛选、排序、批量操作和导出"
      />
      
      <div class="flex-1 flex flex-col gap-4 p-4 overflow-hidden">
        <!-- Header with action buttons -->
        <CaseListHeader client:only="vue" />
        
        <!-- Filters -->
        <CaseListFilters client:only="vue" />
        
        <!-- Batch actions toolbar -->
        <CaseListActions client:only="vue" />
        
        <!-- Table -->
        <div class="flex-1 overflow-auto rounded-lg border bg-card">
          <CaseListTable client:only="vue" />
        </div>
      </div>
    </main>
  </AppSidebarLayout>
</BaseLayout>
